---
interface Props { id: 'snake' | 'dino-run' | 'aim-trainer'; title: string }
const { id, title } = Astro.props;
const help = id === 'snake' ? 'Arrow keys or WASD to turn. On a phone, swipe inside the board or use the direction buttons. Classic has walls; Chill wraps around.' : id === 'dino-run' ? 'Space, Arrow Up or tap the play area to jump. You can also use the Jump button. Land before jumping again. Your score is seconds survived.' : 'Hit the target; empty-space presses count as misses. Score is targets hit, with accuracy shown separately. A timed round lasts 30 seconds. Keyboard players can use untimed Practice.';
---
<div class={`play-panel arcade-game arcade-${id}`} id={id} data-play-panel={id}>
  <div class="challenge-context" data-challenge-context hidden><div><span class="eyebrow" data-challenge-kind></span><p data-challenge-goal></p></div><a class="text-link" href={`/play/${id}/`}>Free play <span aria-hidden="true">↗</span></a></div>
  <fieldset class="arcade-toolbar" data-play-controls disabled><legend class="sr-only">{title} controls</legend>
    <label class="tower-mode">Your pace <select data-arcade-mode><option value="classic">{id === 'aim-trainer' ? '30-second round' : 'Classic'}</option><option value={id === 'aim-trainer' ? 'practice' : 'chill'}>{id === 'aim-trainer' ? 'Untimed practice' : 'Chill'}</option></select></label>
    <div class="arcade-actions"><button class="button button-primary" type="button" data-arcade-action>Start game</button><button class="play-control" type="button" data-arcade-pause disabled>Pause</button><button class="play-control" type="button" data-arcade-reset>New game</button></div>
  </fieldset>
  <dl class="arcade-hud"><div><dt>{id === 'aim-trainer' ? 'Targets hit' : id === 'snake' ? 'Food collected' : 'Seconds survived'}</dt><dd data-arcade-score>0</dd></div><div><dt>Best <span class="sr-only">in this mode on this device</span></dt><dd data-arcade-best>0</dd></div><div><dt data-arcade-extra-label>{id === 'aim-trainer' ? 'Accuracy' : 'Your pace'}</dt><dd data-arcade-extra>{id === 'aim-trainer' ? '0%' : 'Classic'}</dd></div></dl>
  <div class="arcade-stage" data-arcade-stage>
    {id === 'aim-trainer' ? <div class="aim-field" data-arcade-field role="group" aria-label="Aim Trainer play area" aria-describedby="arcade-help"><button class="aim-target" data-aim-target type="button" aria-label="Hit the target" disabled hidden><span/><span class="sr-only">Target</span></button></div> : <canvas width={id === 'snake' ? 600 : 900} height={id === 'snake' ? 600 : 350} data-arcade-field tabindex="0" role="group" aria-label={`${title} play area`} aria-describedby="arcade-help">Your browser needs canvas support for this game.</canvas>}
    <div class="arcade-overlay" data-arcade-overlay aria-hidden="true"><span class="eyebrow" data-arcade-overlay-label>Make a little time</span><strong data-arcade-overlay-title>{id === 'snake' ? 'A growing appetite.' : id === 'dino-run' ? 'A little leap of faith.' : 'Find your focus.'}</strong><span data-arcade-overlay-note>Choose Start game when you’re ready.</span></div>
  </div>
  {id === 'snake' && <fieldset class="snake-directions" data-play-controls disabled><legend class="sr-only">Snake direction controls</legend><button class="play-control" data-snake-direction="up" type="button" aria-label="Turn up">↑</button><button class="play-control" data-snake-direction="left" type="button" aria-label="Turn left">←</button><button class="play-control" data-snake-direction="down" type="button" aria-label="Turn down">↓</button><button class="play-control" data-snake-direction="right" type="button" aria-label="Turn right">→</button></fieldset>}
  {id === 'dino-run' && <button class="play-control dino-jump" type="button" data-dino-jump disabled>Jump <span aria-hidden="true">↑</span></button>}
  <div class="arcade-feedback"><p role="status" data-arcade-status>Choose a pace, then start.</p><p class="game-help" id="arcade-help">{help} Press P inside the play area to pause. Timed games pause while away.</p><p class="game-storage-note" data-arcade-storage>Personal records stay in this browser, separately for each mode.</p></div>
  <div class="arcade-results" data-arcade-results hidden><div><p class="eyebrow">Your round</p><p data-arcade-result></p><p class="game-storage-note" data-arcade-badges></p></div><button class="play-control" data-arcade-share type="button">Challenge a friend <span aria-hidden="true">↗</span></button><label class="share-fallback" data-share-fallback hidden>Copy this challenge link<input type="text" readonly data-share-link/></label><p class="game-storage-note" data-share-status role="status"></p></div>
</div>
