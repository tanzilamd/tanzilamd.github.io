---
import Icon from './Icon.astro';
import { playRoutes, type PlayKey } from '../lib/play-routes';
interface Props { activity: { id: PlayKey; number: string; title: string; label: string; description: string; action: string; group: string } }
const { activity: a } = Astro.props;
---
<a class={`play-choice choice-${a.id}`} href={playRoutes[a.id]} id={a.id} data-play-choice={a.id}>
  <div class={`play-choice-art preview-${a.id}`} aria-hidden="true">
    {a.id === 'snake' ? <svg viewBox="0 0 300 190"><path d="M65 65h100v60h-60v35h100V93" fill="none" stroke="#a4c9b5" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/><circle cx="209" cy="87" r="2.5" fill="#0a191d"/><circle cx="201" cy="87" r="2.5" fill="#0a191d"/><circle cx="228" cy="43" r="9" fill="#f39a80"/></svg>
    : a.id === 'dino-run' ? <svg viewBox="0 0 300 190"><path d="M32 153h236" stroke="#7e9695"/><g fill="#a4c9b5" transform="translate(64 67) scale(1.2)"><path d="M16 0h42v25H39v14H17v15H8V31H0V15h10v17h8V18h-2Z"/><path d="M17 48h9v16h-9zm19-10h9v18h-9Z"/></g><rect x="220" y="116" width="13" height="36" rx="3" fill="#f39a80"/><path d="M215 122v12h23v-8" fill="none" stroke="#f39a80" stroke-width="5"/><path d="M143 62h32m-8-8 8 8-8 8" fill="none" stroke="#edce83" stroke-width="2"/></svg>
    : a.id === 'aim-trainer' ? <svg viewBox="0 0 300 190"><g fill="none" stroke="#a4c9b5"><circle cx="150" cy="95" r="63" opacity=".25"/><circle cx="150" cy="95" r="42" stroke-width="2"/><circle cx="150" cy="95" r="20" stroke-width="4"/></g><circle cx="150" cy="95" r="6" fill="#f39a80"/><path d="M150 20v20m0 110v20M75 95h20m110 0h20" stroke="#f39a80" stroke-width="2"/></svg>
    : a.id === 'tic-tac-toe' ? <div class="preview-tic-board"><span class="preview-tic-x"/><span/><span class="preview-tic-o"/><span/><span class="preview-tic-x"/><span/><span class="preview-tic-o"/><span/><span class="preview-tic-x"/></div>
    : a.id === 'stack-tower' ? <div class="preview-tower-blocks">{[0,1,2,3,4].map(level => <span style={`--level:${level}`}/>)}<i/></div>
    : a.id === 'playground' ? <><span class="preview-circle"/><span class="preview-square"/><span class="preview-star"/><span class="preview-orbit"/></>
    : a.id === 'draw' ? <><svg viewBox="0 0 300 180" fill="none"><path d="M35 125C60 25 95 150 125 72S170 40 170 92s55 42 80-42" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg><span class="preview-pencil"/></>
    : <><span class="preview-press">DO NOT<br/>PRESS</span><span class="preview-warning">!</span></>}
    <span class="play-choice-number">{a.number}</span>
  </div>
  <div class="play-choice-copy"><p class="eyebrow">{a.label}</p><h3>{a.title}</h3><p>{a.description}</p><span class="text-link">{a.action}<Icon name="arrow" size={18}/></span></div>
</a>
