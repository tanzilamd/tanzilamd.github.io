---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
interface Props { items: CollectionEntry<'milestones'>[]; variant?: 'list' | 'grid' }
const { items, variant = 'list' } = Astro.props;
const entries = await Promise.all(items.map(async (item) => ({
  item,
  proof: item.data.image ? (await getImage({ src: item.data.image, width: item.data.image.width, format: 'webp', quality: 90 })).src : undefined,
})));
---
<div class={variant === 'grid' ? 'recognition-grid' : 'recognition-list'}>
  {entries.map(({ item, proof }) => <article id={`milestone-${item.id}`} data-recognition={item.id}>
    <span class="recognition-year mono">{item.data.year ?? '—'}</span>
    <div class="recognition-content">
      <div class="recognition-copy"><p class="eyebrow">{item.data.kind}</p><h3>{item.data.title}</h3><p>{item.data.summary}</p>
        {(proof || item.data.url) && <div class="recognition-links">
          {proof && <a class="text-link" href={proof} target="_blank" rel="noopener noreferrer">{item.data.imageLabel}<Icon name="expand" size={16}/></a>}
          {item.data.url && <a class="text-link" href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.urlLabel}<Icon name="diagonal" size={16}/></a>}
        </div>}
      </div>
      {item.data.image && item.data.imagePresentation === 'badge' && <figure class="recognition-badge"><Image src={item.data.image} alt={item.data.imageAlt!} width={256} widths={[128, 192, 256]} sizes="(max-width: 500px) 144px, 128px" format="webp" quality={86} loading="lazy" decoding="async"/></figure>}
    </div>
  </article>)}
</div>
