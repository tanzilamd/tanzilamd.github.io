---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { items: CollectionEntry<'milestones'>[]; variant?: 'list' | 'grid' }
const { items, variant = 'list' } = Astro.props;
---
<div class={variant === 'grid' ? 'recognition-grid' : 'recognition-list'}>
  {items.map((item) => <article>
    <span class="recognition-year mono">{item.data.year ?? '—'}</span>
    <div><p class="eyebrow">{item.data.kind}</p><h3>{item.data.title}</h3><p>{item.data.summary}</p>
      {item.data.url && <a class="text-link" href={item.data.url} target="_blank" rel="noopener noreferrer">View details<Icon name="diagonal" size={16}/></a>}
    </div>
  </article>)}
</div>
