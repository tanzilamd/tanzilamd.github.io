---
import '@fontsource-variable/manrope';
import '@fontsource/hind-siliguri/500.css';
import '@fontsource/hind-siliguri/600.css';
import '../styles/global.css';
import profile from '../data/profile.json';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = profile.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — Tanzil Ahmed` : 'Tanzil Ahmed — Developer & builder';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const nav = [['Work', '/work/'], ['Open source', '/open-source/'], ['About', '/about/'], ['Notes', '/notes/']];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="theme-color" content="#0a191d"/>
    <meta name="color-scheme" content="dark light"/><meta name="generator" content={Astro.generator}/>
    <title>{pageTitle}</title><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="sitemap" href="/sitemap.xml"/>
    {noindex && <meta name="robots" content="noindex"/>}
    <meta property="og:type" content="website"/><meta property="og:locale" content="en_US"/>
    <meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)}/><meta property="og:image:alt" content="Tanzil Ahmed — A curious mind. A maker’s instinct."/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="author" content={profile.name}/>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: profile.name, url: Astro.site, description: profile.description, sameAs: [profile.github, profile.linkedin, profile.dev] }).replace(/</g, '\\u003c')}/>
    <script is:inline>
      (() => { let theme = 'dark'; try { const saved = localStorage.getItem('offscript-theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch {} document.documentElement.dataset.theme = theme; const meta = document.querySelector('meta[name="theme-color"]'); if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a191d' : '#f0f1eb'); })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href="/">TANZIL <span>AHMED<span class="wordmark-dot">.</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-actions"><button type="button" class="theme-toggle icon-button" data-theme-toggle aria-label="Switch to light theme" hidden><Icon name="sun" class="sun-icon"/><Icon name="moon" class="moon-icon"/></button><a class="header-contact" href="/contact/">Let’s talk <Icon name="diagonal" size={16}/></a><button type="button" class="menu-toggle icon-button" data-menu-toggle aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav" hidden><Icon name="menu" class="menu-icon"/><Icon name="close" class="close-icon"/></button></div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" inert hidden>{nav.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}<Icon name="diagonal"/></a>)}<a href="/beyond/">Beyond code<Icon name="diagonal"/></a><a href="/contact/">Let’s talk<Icon name="diagonal"/></a></nav>
      <noscript><nav class="fallback-nav" aria-label="Navigation without JavaScript">{nav.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/contact/">Contact</a></nav></noscript>
    </header>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="site-footer container">
      <div class="footer-top"><a class="footer-heading" href="/contact/">Something on your mind?<br/><span>Let’s talk.</span><Icon name="diagonal" size={38}/></a><p>Good work usually starts<br/>with a good conversation.</p></div>
      <div class="footer-bottom"><a class="wordmark footer-wordmark" href="/">TANZIL AHMED<span class="wordmark-dot">.</span></a><div class="social-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="diagonal" size={14}/></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="diagonal" size={14}/></a><a href={profile.dev} target="_blank" rel="noopener noreferrer">DEV <Icon name="diagonal" size={14}/></a></div><span class="footer-signoff">Made with curiosity. © {new Date().getFullYear()}</span></div>
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
