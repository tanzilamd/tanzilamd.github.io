---
import '@fontsource-variable/manrope';
import '@fontsource/hind-siliguri/500.css';
import '@fontsource/hind-siliguri/600.css';
import '../styles/global.css';
import profile from '../data/profile.json';
import Icon from '../components/Icon.astro';
import PocketSurprise from '../components/PocketSurprise.astro';
import { socialImage, SOCIAL_WIDTH, SOCIAL_HEIGHT } from '../lib/social';
interface Props { title?: string; description?: string; noindex?: boolean; article?: { published: string; updated?: string; genre: string } }
const { title, description = profile.description, noindex = false, article } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : profile.siteTitle;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const shareImage = new URL(socialImage(path, pageTitle, description, profile.name), Astro.site);
const shareAlt = path === '/' ? `${profile.name} — ${profile.headline} ${profile.headlineAccent}` : `${pageTitle} — page preview`;
const nav = [['Projects', '/work/'], ['Open source', '/open-source/'], ['About', '/about/'], ['Activities', '/beyond/'], ['Writing', '/notes/']];
const [firstName, ...restName] = profile.name.split(' ');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="theme-color" content="#0a191d"/>
    <meta name="color-scheme" content="dark light"/><meta name="generator" content={Astro.generator}/>
    <title>{pageTitle}</title><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="sitemap" href="/sitemap.xml"/>
    <link rel="alternate" type="application/rss+xml" title={`Writing by ${profile.name}`} href="/rss.xml"/>
    {noindex && <meta name="robots" content="noindex"/>}
    <meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:locale" content="en_US"/>
    {article && <><meta property="article:published_time" content={article.published}/>{article.updated && <meta property="article:modified_time" content={article.updated}/>}</>}
    <meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:site_name" content={profile.siteTitle}/>
    <meta property="og:image" content={shareImage}/><meta property="og:image:secure_url" content={shareImage}/>
    <meta property="og:image:type" content="image/png"/><meta property="og:image:width" content={String(SOCIAL_WIDTH)}/><meta property="og:image:height" content={String(SOCIAL_HEIGHT)}/><meta property="og:image:alt" content={shareAlt}/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={shareImage}/><meta name="twitter:image:alt" content={shareAlt}/>
    <meta name="author" content={profile.name}/>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: profile.name, url: Astro.site, description: profile.description, sameAs: profile.socialLinks.map((link) => link.url) }).replace(/</g, '\\u003c')}/>
    {article && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, genre: article.genre, datePublished: article.published, dateModified: article.updated ?? article.published, mainEntityOfPage: canonical.href, author: { '@type': 'Person', name: profile.name, url: new URL('/about/', Astro.site).href }, publisher: { '@type': 'Person', name: profile.name } }).replace(/</g, '\\u003c')}/>}
    <script is:inline>
      (() => { let theme = 'dark'; try { const saved = localStorage.getItem('offscript-theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch {} document.documentElement.dataset.theme = theme; const meta = document.querySelector('meta[name="theme-color"]'); if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a191d' : '#f5f4ef'); })();
    </script>
    {path === '/' && <script is:inline>
      (() => {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('offscript-intro-seen')) return;
          sessionStorage.setItem('offscript-intro-seen', 'true');
          document.documentElement.dataset.intro = 'pending';
          // The complete headline remains available if the enhancement fails to load.
          setTimeout(() => { document.documentElement.dataset.intro = 'done'; }, 2200);
        } catch {}
      })();
    </script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href="/">{firstName}<span>{restName.join(' ')}<span class="wordmark-dot">.</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-actions"><button type="button" class="theme-toggle icon-button" data-theme-toggle aria-label="Switch to light theme" hidden><Icon name="sun" class="sun-icon"/><Icon name="moon" class="moon-icon"/></button><a class="header-contact" href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Let’s talk <Icon name="diagonal" size={16}/></a><button type="button" class="menu-toggle icon-button" data-menu-toggle aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav" hidden><Icon name="menu" class="menu-icon"/><Icon name="close" class="close-icon"/></button></div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" inert hidden>{nav.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}<Icon name="diagonal"/></a>)}<a href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact<Icon name="diagonal"/></a></nav>
      <noscript><nav class="fallback-nav" aria-label="Navigation without JavaScript">{nav.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/contact/">Contact</a></nav></noscript>
    </header>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="site-footer container">
      <div class:list={['footer-main', { 'footer-main-contact': path === '/contact/' }]}>
        {path !== '/contact/' && <div class="footer-contact-block"><p class="eyebrow">Have a project or an idea?</p><a class="footer-heading" href="/contact/">Let’s talk.<Icon name="diagonal" size={30}/></a><p>Open to collaborations, new ideas<br/>and learning opportunities.</p></div>}
        <div class="footer-break"><p class="eyebrow">Off the clock</p><a class="footer-play" href="/play/" aria-current={path === '/play/' ? 'page' : undefined}>Take a little break<Icon name="arrow" size={24}/></a><p>Games and small distractions, just for fun.</p></div>
      </div>
      <div class="footer-bottom">
        <div class="footer-identity"><a class="wordmark footer-wordmark" href="/">{profile.name}<span class="wordmark-dot">.</span></a><p class="footer-signoff">Made with curiosity. © {new Date().getFullYear()}</p></div>
        <nav class="social-links" aria-label="Social profiles">{profile.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <Icon name="diagonal" size={14}/></a>)}</nav>
      </div>
    </footer>
    <PocketSurprise/>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
