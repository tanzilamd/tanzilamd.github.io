---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Filters from '../../components/Filters.astro';
import { projects } from '../../lib/content';
const all = await projects();
const categories = [...new Set(all.map((project) => project.data.category))];
---
<Layout title="Projects" description="Software projects and earlier work by Tanzil Ahmed. Explore Tuktak, ScopeProof, EngJatra and PlayPiku.">
  <div class="container page-body"><header class="page-heading"><p class="eyebrow">Products, tools & experiments</p><h1>My <span class="serif-word">projects.</span></h1><p>Software I’ve worked on, with the problem each project addresses, my role, and links to the source code or demo.</p></header>
  <Filters options={categories} label="Filter projects by category"/>
  <div class="work-grid">{all.map((project) => <ProjectCard project={project}/>)}</div>
  <p class="archive-footnote">Earlier work is part of the story, too. Archived projects may no longer have a running demo.</p></div>
</Layout>
