---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Filters from '../components/Filters.astro';
import { contributions, milestones } from '../lib/content';
const all = await contributions();
const events = (await milestones()).filter((item) => item.id.startsWith('hacktoberfest'));
const types = [...new Set(all.map((item) => item.data.type))];
const dateLabel = (date: string) => new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(date));
---
<Layout title="Open source" description="Code, learning resources and community contributions by Tanzil Ahmed, with links to the original pull requests.">
  <div class="container page-body"><header class="page-heading"><p class="eyebrow"><Icon name="branch" size={18}/> Small contributions. Shared progress.</p><h1>Better, <span class="serif-word">together.</span></h1><p>Open source is more than a code change. Sometimes it’s a useful resource, a clearer explanation, or making something easier for the next person.</p></header>
    <Filters options={types} label="Filter contributions by type"/>
    <div class="contribution-list">{all.map((item) => <article class="contribution-row" data-item data-category={item.data.type}><div class="contribution-icon"><Icon name={item.data.type === 'Code' ? 'code' : item.data.type === 'Infrastructure' ? 'branch' : 'book'} size={24}/></div><div class="contribution-main"><p class="repo-name">{item.data.repository}</p><h2><a href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.title}<Icon name="diagonal" size={17}/></a></h2><p>{item.data.summary}</p><div class="entry-meta"><span>{item.data.type}</span><span>{item.data.relationship}</span>{item.data.event && <span>{item.data.event}</span>}</div></div><div class="contribution-state"><span class:list={["merge-status", `status-${item.data.status.toLowerCase()}`]}><Icon name={item.data.status === "Merged" ? "check" : "branch"} size={13}/>{item.data.status}</span><a class="pr-link mono" href={item.data.url} target="_blank" rel="noopener noreferrer">#{item.data.pr} <Icon name="diagonal" size={14}/></a>{item.data.mergedAt && <time datetime={item.data.mergedAt}>{dateLabel(item.data.mergedAt)}</time>}</div></article>)}</div>
    <p class="archive-footnote">A selected contribution archive. Personal-fork and organization work are labelled separately from upstream contributions.</p>
    <section class="milestone-section section"><div class="section-top"><div><p class="eyebrow">The community along the way</p><h2>Showing <span class="serif-word">up.</span></h2></div></div><div class="milestone-grid">{events.map((event) => <article class="milestone-card"><span class="milestone-year">{event.data.year}</span><p class="eyebrow">{event.data.kind}</p><h3>{event.data.title}</h3><p>{event.data.summary}</p>{event.data.url && <a class="text-link" href={event.data.url} target="_blank" rel="noopener noreferrer">See the contributions<Icon name="diagonal" size={16}/></a>}</article>)}</div></section>
    <section class="tabbycat-note"><Icon name="branch" size={30}/><div><p class="eyebrow">Where debate meets software</p><h2>A little context on Tabbycat.</h2><p>Tabbycat is open-source debating tournament software for draws, adjudicator allocation, ballots and standings. My earlier deployment work around it lives in the project archive; the container workflow above is in my own fork.</p><a class="text-link" href="/work/cargotab/">The Cargotab story<Icon name="arrow" size={16}/></a></div></section>
  </div>
</Layout>
