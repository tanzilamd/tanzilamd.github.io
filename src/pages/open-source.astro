---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Filters from '../components/Filters.astro';
import { contributions, milestones } from '../lib/content';
import { render } from 'astro:content';
const all = await contributions();
const events = (await milestones()).filter((item) => item.id.startsWith('hacktoberfest'));
const types = [...new Set(all.map((item) => item.data.type))];
const spotlight = all.find((item) => item.data.spotlight);
const renderedSpotlight = spotlight ? await render(spotlight) : null;
const SpotlightContent = renderedSpotlight?.Content;
const dateLabel = (date: string) => new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(date));
---
<Layout title="Open source" description="Code, learning resources and community contributions by Tanzil Ahmed, with links to the original pull requests.">
  <div class="container page-body"><header class="page-heading"><p class="eyebrow"><Icon name="branch" size={18}/> Websites, code & learning resources</p><h1>Open-source<br/><span class="serif-word">contributions.</span></h1><p>My contributions to open-source projects, from website development to programming resources and infrastructure. Each entry links to the original work.</p></header>
    {spotlight && SpotlightContent && <section class="contribution-spotlight" aria-labelledby="spotlight-heading"><div class="spotlight-heading"><p class="eyebrow">Featured contribution · {spotlight.data.type}</p><h2 id="spotlight-heading">{spotlight.data.title}</h2><p>{spotlight.data.summary}</p><span class="merge-status status-published">{spotlight.data.status}</span></div><div class="spotlight-body"><SpotlightContent/><div class="spotlight-links">{spotlight.data.projectUrl && <a class="button button-primary" href={spotlight.data.projectUrl} target="_blank" rel="noopener noreferrer">Visit website<Icon name="diagonal" size={17}/></a>}<a class="text-link" href={spotlight.data.url} target="_blank" rel="noopener noreferrer">View source code<Icon name="diagonal" size={16}/></a>{spotlight.data.evidenceUrl && <a class="text-link" href={spotlight.data.evidenceUrl} target="_blank" rel="noopener noreferrer">Official integration<Icon name="diagonal" size={16}/></a>}</div></div></section>}
    <Filters options={types} label="Filter contributions by type"/>
    <div class="contribution-list">{all.map((item) => <article class="contribution-row" data-item data-category={item.data.type}><div class="contribution-icon"><Icon name={item.data.type === 'Code' ? 'code' : item.data.type === 'Infrastructure' || item.data.type === 'Website' ? 'branch' : 'book'} size={24}/></div><div class="contribution-main"><p class="repo-name">{item.data.repository}</p><h2><a href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.title}<Icon name="diagonal" size={17}/></a></h2><p>{item.data.summary}</p><div class="entry-meta"><span>{item.data.type}</span><span>{item.data.relationship}</span>{item.data.event && <span>{item.data.event}</span>}</div></div><div class="contribution-state"><span class:list={["merge-status", `status-${item.data.status.toLowerCase()}`]}><Icon name={item.data.status === "Merged" || item.data.status === "Published" ? "check" : "branch"} size={13}/>{item.data.status}</span>{item.data.pr && <a class="pr-link mono" href={item.data.url} target="_blank" rel="noopener noreferrer">#{item.data.pr} <Icon name="diagonal" size={14}/></a>}{item.data.mergedAt && <time datetime={item.data.mergedAt}>{dateLabel(item.data.mergedAt)}</time>}</div></article>)}</div>
    <p class="archive-footnote">A selected contribution archive. Personal-fork and organization work are labelled separately from upstream contributions.</p>
    <section class="milestone-section section"><div class="section-top"><div><p class="eyebrow">Participation & completion</p><h2>Hacktoberfest <span class="serif-word">milestones.</span></h2></div></div><div class="milestone-grid">{events.map((event) => <article class="milestone-card"><span class="milestone-year">{event.data.year}</span><p class="eyebrow">{event.data.kind}</p><h3>{event.data.title}</h3><p>{event.data.summary}</p>{event.data.url && <a class="text-link" href={event.data.url} target="_blank" rel="noopener noreferrer">View contributions<Icon name="diagonal" size={16}/></a>}</article>)}</div></section>
  </div>
</Layout>
