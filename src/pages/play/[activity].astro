---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PlayWorkspace from '../../components/PlayWorkspace.astro';
import copy from '../../lib/play';
import { playRoutes, type PlayKey } from '../../lib/play-routes';
import '../../styles/play.css';
export function getStaticPaths() {
  return Object.entries(playRoutes).map(([id, path]) => ({ params: { activity: path.split('/')[2] }, props: { id: id as PlayKey } }));
}
interface Props { id: PlayKey }
const { id } = Astro.props;
const activity = copy.activities.find((item) => item.id === id)!;
---
<Layout title={activity.title} description={activity.description}>
  <div class="container page-body play-page game-page">
    <a class="text-link play-back" href="/play/" data-play-close><span aria-hidden="true">←</span> All activities</a>
    <header class="game-heading"><p class="eyebrow">A little break / {activity.number}</p><h1>{activity.title}<span class="serif-word">.</span></h1><p>{activity.description}</p></header>
    <section class="play-workspace" data-play-workspace data-game-id={id} aria-label={activity.title}>
      <p class="play-load-status" data-play-load role="status"></p><button class="button button-secondary" data-play-retry hidden type="button">Try again</button>
      <noscript><p class="play-fallback">This activity needs JavaScript. The other <a href="/play/">activities</a> and the <a href="/work/">portfolio</a> are still here to explore.</p></noscript>
      <PlayWorkspace id={id}/>
    </section>
    <nav class="game-switcher" aria-label="More activities"><span class="eyebrow">Another little break?</span>{copy.activities.filter((item) => item.id !== id).map((item) => <a class="text-link" href={playRoutes[item.id]} data-play-choice={item.id}>{item.title}<Icon name="arrow" size={16}/></a>)}</nav>
  </div>
  <script src="../../scripts/play/index.ts"></script>
</Layout>
