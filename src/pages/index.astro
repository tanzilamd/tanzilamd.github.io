---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecognitionList from '../components/RecognitionList.astro';
import WritingCard from '../components/WritingCard.astro';
import portrait from '../assets/tanzil.jpg';
import profile from '../data/profile.json';
import { projects, contributions, notes, milestones, activities } from '../lib/content';
const featured = (await projects()).filter((project) => project.data.featured).slice(0, 4);
const selectedContributions = (await contributions()).filter((item) => item.data.featured).slice(0, 3);
const latestNotes = await notes();
const featuredWriting = latestNotes.find((note) => note.data.featured) ?? latestNotes[0];
const selectedActivities = (await activities()).filter((activity) => activity.data.featured);
const recognition = (await milestones()).filter((item) => item.data.featured).slice(0, 3);
---
<Layout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy"><p class="eyebrow">{profile.label}</p><h1 id="hero-heading">{profile.headline}<br/><span>{profile.headlineAccent}</span></h1><p class="hero-intro">{profile.intro}</p><div class="hero-actions"><a class="button button-primary" href="/work/">View projects <Icon name="arrow" size={18}/></a><a class="button button-secondary" href="/about/">About me</a></div><div class="hero-footnote"><a href="/about/#experience">Work experience</a><span aria-hidden="true">·</span><a href="/about/#recognition">Awards & recognition</a></div></div>
    <figure class="hero-portrait"><div class="portrait-wrap"><Image src={portrait} alt={profile.portraitAlt} widths={[480, 720, 1080, 1280]} sizes="(max-width: 799px) 92vw, 40vw" loading="eager" fetchpriority="high" format="webp" quality={88}/></div><figcaption><span>{profile.name}</span><span>{profile.portraitCaption}</span></figcaption></figure>
  </section>
  <section class="section container" aria-labelledby="work-heading">
    <div class="section-top"><div><p class="eyebrow">Software I’ve worked on</p><h2 id="work-heading">Selected <span class="serif-word">projects.</span></h2></div><a class="text-link" href="/work/">All projects <Icon name="diagonal" size={18}/></a></div>
    <div class="featured-grid">{featured.map((project) => <ProjectCard project={project} headingLevel={3}/>)}</div>
  </section>
  <section class="open-section container" aria-labelledby="open-heading"><div class="open-inner"><div class="open-intro"><p class="eyebrow">Websites, code & learning resources</p><h2 id="open-heading">Open-source<br/><span class="serif-word">contributions.</span></h2><p>From the Tabbycat software website to programming resources and community projects. See what I contributed and follow the original sources.</p><a class="text-link" href="/open-source/">View contributions <Icon name="arrow" size={18}/></a></div><div class="open-preview">{selectedContributions.map((item) => <a class="contribution-preview" href={item.data.projectUrl ?? item.data.url} target="_blank" rel="noopener noreferrer"><span><span class="eyebrow">{item.data.type} · {item.data.relationship}</span><strong>{item.data.title}</strong><span class="preview-summary">{item.data.summary}</span></span><span class="preview-end"><span class:list={["merge-status", `status-${item.data.status.toLowerCase()}`]}>{item.data.status}</span><Icon name="diagonal" size={18}/></span></a>)}</div></div></section>
  {recognition.length > 0 && <section class="section container" aria-labelledby="recognition-heading"><div class="section-top"><div><p class="eyebrow">Writing, community & open source</p><h2 id="recognition-heading">Selected <span class="serif-word">recognition.</span></h2></div><a class="text-link" href="/about/#recognition">All awards & milestones <Icon name="diagonal" size={18}/></a></div><RecognitionList items={recognition} variant="grid"/></section>}
  <section class="beyond-teaser container section" aria-labelledby="beyond-heading"><div class="beyond-title"><p class="eyebrow">Leadership, performance & volunteering</p><h2 id="beyond-heading">Activities &<br/><span class="serif-word">community.</span></h2><a class="text-link" href="/beyond/">View activities <Icon name="diagonal" size={18}/></a></div><div class="beyond-stories">{selectedActivities.map((activity, index) => <a href={`/beyond/#${activity.id}`}><span class="story-number">{String(index + 1).padStart(2, '0')}</span><span><strong>{activity.data.title}</strong><span>{activity.data.summary}</span></span><Icon name="diagonal"/></a>)}</div></section>
  {featuredWriting && <section class="notes-teaser container section" aria-labelledby="writing-heading"><div class="section-top"><div><p class="eyebrow">Personal essays & project write-ups</p><h2 id="writing-heading">My <span class="serif-word">writing.</span></h2></div><a class="text-link" href="/notes/">All writing <Icon name="diagonal" size={18}/></a></div><WritingCard note={featuredWriting} compact/></section>}
</Layout>
