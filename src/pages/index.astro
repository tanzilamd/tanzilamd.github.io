---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecognitionList from '../components/RecognitionList.astro';
import portrait from '../assets/tanzil.jpg';
import profile from '../data/profile.json';
import { projects, contributions, notes, milestones } from '../lib/content';
const featured = (await projects()).filter((project) => project.data.featured).slice(0, 4);
const selectedContributions = (await contributions()).filter((item) => item.data.featured).slice(0, 3);
const latestNotes = await notes();
const recognition = (await milestones()).filter((item) => item.data.featured).slice(0, 3);
---
<Layout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy"><p class="eyebrow"><span class="small-spark"><Icon name="spark" size={18}/></span>{profile.label}</p><h1 id="hero-heading">{profile.headline}<br/><span>{profile.headlineAccent}</span></h1><p class="hero-intro">{profile.intro}</p><div class="hero-actions"><a class="button button-primary" href="/work/">View projects <Icon name="diagonal" size={18}/></a><a class="text-link" href="/about/">About me <Icon name="arrow" size={17}/></a></div><div class="hero-footnote"><a href="/about/#experience">Work experience</a><span aria-hidden="true">·</span><a href="/about/#recognition">Awards & recognition</a></div></div>
    <figure class="hero-portrait"><div class="portrait-wrap"><Image src={portrait} alt="Tanzil Ahmed seated by a window, wearing a patterned shirt and sunglasses." widths={[480, 720, 1080, 1280]} sizes="(max-width: 799px) 92vw, 44vw" loading="eager" fetchpriority="high" format="webp" quality={88}/><span class="portrait-corner" aria-hidden="true"><Icon name="diagonal" size={18}/></span></div><figcaption><span>Tanzil Ahmed</span><span>Software, debate, theatre & teaching.</span></figcaption></figure>
  </section>
  <section class="section container" aria-labelledby="work-heading">
    <div class="section-top"><div><p class="eyebrow">Software I’ve worked on</p><h2 id="work-heading">Selected <span class="serif-word">projects.</span></h2></div><a class="text-link" href="/work/">All projects <Icon name="diagonal" size={18}/></a></div>
    <div class="featured-grid">{featured.map((project, index) => <ProjectCard project={project} large={index < 2}/>)}</div>
  </section>
  <section class="open-section" aria-labelledby="open-heading"><div class="container open-inner"><div class="open-intro"><p class="eyebrow"><Icon name="branch" size={18}/> Websites, code & learning resources</p><h2 id="open-heading">Open-source<br/><span class="serif-word">contributions.</span></h2><p>From the Tabbycat software website to programming resources and community projects. See what I contributed and follow the original sources.</p><a class="text-link" href="/open-source/">View contributions <Icon name="diagonal" size={18}/></a></div><div class="open-preview">{selectedContributions.map((item) => <a class="contribution-preview" href={item.data.projectUrl ?? item.data.url} target="_blank" rel="noopener noreferrer"><span><span class="eyebrow">{item.data.type} · {item.data.relationship}</span><strong>{item.data.title}</strong><span class="preview-summary">{item.data.summary}</span></span><span class="preview-end"><span class:list={["merge-status", `status-${item.data.status.toLowerCase()}`]}>{item.data.status}</span><span class="mono">{item.data.pr ? `#${item.data.pr}` : 'View website'} <Icon name="diagonal" size={14}/></span></span></a>)}</div></div></section>
  {recognition.length > 0 && <section class="section container" aria-labelledby="recognition-heading"><div class="section-top"><div><p class="eyebrow">Writing, community & open source</p><h2 id="recognition-heading">Selected <span class="serif-word">recognition.</span></h2></div><a class="text-link" href="/about/#recognition">All awards & milestones <Icon name="diagonal" size={18}/></a></div><RecognitionList items={recognition} variant="grid"/></section>}
  <section class="beyond-teaser container section" aria-labelledby="beyond-heading"><div class="beyond-title"><p class="eyebrow">Leadership, performance & volunteering</p><h2 id="beyond-heading">Activities &<br/><span class="serif-word">community.</span></h2><a class="text-link" href="/beyond/">View activities <Icon name="diagonal" size={18}/></a></div><div class="beyond-stories"><a href="/beyond/#debate"><span class="story-number">01</span><span><strong>Debate & leadership</strong><span>Founded and led my school’s debating club.</span></span><Icon name="diagonal"/></a><a href="/beyond/#theatre"><span class="story-number">02</span><span><strong>Theatre & mime</strong><span>Performed in more than 25 stage productions.</span></span><Icon name="diagonal"/></a><a href="/beyond/#teaching"><span class="story-number">03</span><span><strong>Teaching & volunteering</strong><span>Taught introductory coding to 50+ students.</span></span><Icon name="diagonal"/></a></div></section>
  {latestNotes.length > 0 && <section class="notes-teaser container section"><div class="section-top"><div><p class="eyebrow">Articles about my projects</p><h2>Latest <span class="serif-word">writing.</span></h2></div><a class="text-link" href="/notes/">All articles <Icon name="diagonal" size={18}/></a></div>{latestNotes.slice(0, 1).map((note) => <a class="note-feature" href={note.data.url} target="_blank" rel="noopener noreferrer"><div><span class="eyebrow">{note.data.platform} · {note.data.tags[0]}</span><h3>{note.data.title}</h3><p>{note.data.summary}</p></div><span class="round-arrow"><Icon name="diagonal" size={24}/></span></a>)}</section>}
</Layout>
