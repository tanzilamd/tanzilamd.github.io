---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import portrait from '../assets/tanzil.jpg';
import profile from '../data/profile.json';
import { projects, contributions, notes } from '../lib/content';
const featured = (await projects()).filter((project) => project.data.featured).slice(0, 4);
const selectedContributions = (await contributions()).filter((item) => item.data.featured).slice(0, 3);
const latestNotes = await notes();
---
<Layout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy"><p class="eyebrow"><span class="small-spark"><Icon name="spark" size={18}/></span> Developer & builder</p><h1 id="hero-heading">{profile.headline}<br/><span>{profile.headlineAccent}</span></h1><p class="hero-intro">{profile.intro}</p><div class="hero-actions"><a class="button button-primary" href="/work/">Discover my work <Icon name="diagonal" size={18}/></a><a class="text-link" href="/about/">The person behind it <Icon name="arrow" size={17}/></a></div><div class="hero-footnote"><span class="footnote-line"></span> Thoughtfully made. Always learning.</div></div>
    <figure class="hero-portrait"><div class="portrait-wrap"><Image src={portrait} alt="Tanzil Ahmed seated by a window, wearing a patterned shirt and sunglasses." widths={[480, 720, 1080, 1280]} sizes="(max-width: 799px) 92vw, 44vw" loading="eager" fetchpriority="high" format="webp" quality={88}/><span class="portrait-corner" aria-hidden="true"><Icon name="diagonal" size={18}/></span></div><figcaption><span>Tanzil Ahmed</span><span>A little beyond the screen.</span></figcaption></figure>
  </section>
  <section class="section container" aria-labelledby="work-heading">
    <div class="section-top"><div><p class="eyebrow">A few things I’ve put into the world</p><h2 id="work-heading">Selected <span class="serif-word">work.</span></h2></div><a class="text-link" href="/work/">All projects <Icon name="diagonal" size={18}/></a></div>
    <div class="featured-grid">{featured.map((project, index) => <ProjectCard project={project} large={index < 2}/>)}</div>
  </section>
  <section class="open-section" aria-labelledby="open-heading"><div class="container open-inner"><div class="open-intro"><p class="eyebrow"><Icon name="branch" size={18}/> Building in public</p><h2 id="open-heading">Some things are better<br/><span class="serif-word">built together.</span></h2><p>Useful resources, community projects, and small contributions that become part of something bigger.</p><a class="text-link" href="/open-source/">Explore my contributions <Icon name="diagonal" size={18}/></a></div><div class="open-preview">{selectedContributions.map((item) => <a class="contribution-preview" href={item.data.url} target="_blank" rel="noopener noreferrer"><span><span class="eyebrow">{item.data.repository.split('/')[0]}</span><strong>{item.data.repository.split('/')[1]}</strong><span class="preview-summary">{item.data.summary}</span></span><span class="preview-end"><span class:list={["merge-status", `status-${item.data.status.toLowerCase()}`]}>{item.data.status}</span><span class="mono">#{item.data.pr} <Icon name="diagonal" size={14}/></span></span></a>)}</div></div></section>
  <section class="beyond-teaser container section" aria-labelledby="beyond-heading"><div class="beyond-title"><p class="eyebrow">Not everything happens in an editor</p><h2 id="beyond-heading">Code is a craft.<br/><span class="serif-word">Curiosity is a habit.</span></h2><a class="text-link" href="/beyond/">A little beyond code <Icon name="diagonal" size={18}/></a></div><div class="beyond-stories"><a href="/beyond/#debate"><span class="story-number">01</span><span><strong>Finding my voice.</strong><span>Debate & leadership</span></span><Icon name="diagonal"/></a><a href="/beyond/#theatre"><span class="story-number">02</span><span><strong>Seeing another perspective.</strong><span>Theatre & mime</span></span><Icon name="diagonal"/></a><a href="/beyond/#teaching"><span class="story-number">03</span><span><strong>Passing something on.</strong><span>Teaching & community</span></span><Icon name="diagonal"/></a></div></section>
  {latestNotes.length > 0 && <section class="notes-teaser container section"><div class="section-top"><div><p class="eyebrow">From the notebook</p><h2>Thinking <span class="serif-word">out loud.</span></h2></div><a class="text-link" href="/notes/">All notes <Icon name="diagonal" size={18}/></a></div>{latestNotes.slice(0, 1).map((note) => <a class="note-feature" href={note.data.url} target="_blank" rel="noopener noreferrer"><div><span class="eyebrow">{note.data.platform} · {note.data.tags[0]}</span><h3>{note.data.title}</h3><p>{note.data.summary}</p></div><span class="round-arrow"><Icon name="diagonal" size={24}/></span></a>)}</section>}
</Layout>
