---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { activities } from '../lib/content';
const all = await Promise.all((await activities()).map(async (activity) => ({ activity, ...(await render(activity)) })));
---
<Layout title="Activities & community" description="Tanzil Ahmed’s experience in debate, club leadership, theatre, teaching, scouting and community service.">
  <div class="container page-body"><header class="page-heading"><p class="eyebrow">Leadership, performance & volunteering</p><h1>Activities &<br/><span class="serif-word">community.</span></h1><p>Alongside software, I’ve spent time organizing debates, performing on stage, teaching, and volunteering. Here’s what that involved.</p></header>
    <div class="life-stories">{all.map(({ activity, Content }, index) => <section class="life-story" id={activity.id}><span class="life-number">{String(index + 1).padStart(2, '0')} /</span><div><p class="eyebrow">{activity.data.label}</p><h2>{activity.data.title}</h2><p>{activity.data.summary}</p><div class="activity-prose"><Content/></div></div><div class:list={['life-art', activity.data.art === 'community' ? 'teaching-art' : `${activity.data.art}-art`]} aria-hidden="true">{activity.data.art === 'debate' ? <><span>Listen.</span><span>Question.</span><span>Understand.</span><span class="art-plus">↗</span></> : activity.data.art === 'theatre' ? <><span class="theatre-line"></span><span>{activity.data.title}</span><span class="art-plus">✳</span></> : <><Icon name="sprout" size={100}/><span>Learn.<br/>Share.<br/>Help.</span></>}</div></section>)}</div>
  </div>
</Layout>
