---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import RecognitionList from '../components/RecognitionList.astro';
import WritingCard from '../components/WritingCard.astro';
import profile from '../data/profile.json';
import portrait from '../assets/tanzil.jpg';
import { experience, milestones, notes } from '../lib/content';
const roles = await experience();
const personalEssay = (await notes()).find((note) => note.data.kind === 'post' && note.data.genre === 'Essay' && note.data.featured);
const allMilestones = await milestones();
const recognition = allMilestones.filter((item) => !item.id.startsWith('hacktoberfest'));
const openSourceMilestones = allMilestones.filter((item) => item.id.startsWith('hacktoberfest'));
---
<Layout title="About" description="Tanzil Ahmed’s background, work experience, awards, debate, theatre, teaching and community involvement.">
  <div class="container page-body"><header class="page-heading"><p class="eyebrow">Background, experience & recognition</p><h1>About <span class="serif-word">me.</span></h1></header>
    <section class="about-intro"><figure class="about-photo"><Image src={portrait} alt={profile.portraitAlt} widths={[480, 800, 1280]} sizes="(max-width: 799px) 90vw, 40vw" format="webp" loading="eager"/><figcaption>{profile.name}</figcaption></figure><div class="about-copy"><h2>{profile.about.heading}</h2>{profile.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href={profile.about.link.url}>{profile.about.link.label}<Icon name="diagonal" size={17}/></a></div></section>
    {personalEssay && <section class="about-writing" aria-label="A personal essay"><WritingCard note={personalEssay} compact/></section>}
    <section class="section experience-section" id="experience" aria-labelledby="experience-heading"><div><p class="eyebrow">Development, coordination & volunteering</p><h2 id="experience-heading">Work<br/><span class="serif-word">experience.</span></h2></div><div class="experience-list">{roles.map((role) => <article><p class="eyebrow">{role.data.role}</p><h3>{role.data.title}</h3><p>{role.data.summary}</p></article>)}</div></section>
    <section class="section" id="recognition" aria-labelledby="awards-heading"><div class="section-top"><div><p class="eyebrow">Competition results, nomination & service</p><h2 id="awards-heading">Awards &<br/><span class="serif-word">recognition.</span></h2></div></div><RecognitionList items={recognition}/></section>
    <section class="section" aria-labelledby="milestones-heading"><div class="section-top"><div><p class="eyebrow">Participation & completion</p><h2 id="milestones-heading">Open-source <span class="serif-word">milestones.</span></h2></div></div><RecognitionList items={openSourceMilestones}/></section>
  </div>
</Layout>
