---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
---
<Layout title="Contact" description="Start a conversation with Tanzil Ahmed about a project, an idea or open-source collaboration.">
  <div class="container page-body contact-page"><header class="page-heading"><p class="eyebrow">Projects, collaboration & questions</p><h1>Get in <span class="serif-word">touch.</span></h1><p>Have a project, a question, or an opportunity to learn something new? Contact me through one of the profiles below.</p></header>
    <div class="contact-layout"><div class="contact-intro"><h2>Let’s make<br/>a connection.</h2><p>A little context goes a long way: tell me what you’re working on, what you have in mind, and where I might fit.</p></div><div class="contact-links">{profile.email && <div class="email-contact"><a href={`mailto:${profile.email}`}><span><span class="eyebrow">Email</span><strong>{profile.email}</strong></span><Icon name="mail" size={28}/></a><button type="button" data-copy-email={profile.email} class="text-link" hidden><Icon name="copy" size={16}/>Copy email</button><p data-copy-status role="status"/></div>}{profile.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer"><span><span class="eyebrow">{link.eyebrow}</span><strong>{link.label}</strong><span>{link.description}</span></span><Icon name="diagonal" size={28}/></a>)}</div></div>
  </div>
</Layout>
