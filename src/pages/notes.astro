---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { notes } from '../lib/content';
const all = await notes();
---
<Layout title="Notes" description="Writing about building software, making decisions and learning in public. Notes and DEV articles by Tanzil Ahmed.">
  <div class="container page-body"><header class="page-heading"><p class="eyebrow">Thinking out loud</p><h1>A few notes<br/>from the <span class="serif-word">journey.</span></h1><p>What I’m building, the decisions behind it, and the things I’m learning along the way.</p></header>
    <div class="notes-list">{all.map((note) => <article class="note-entry"><div class="note-date"><span class="eyebrow">{note.data.platform}</span><time datetime={note.data.date}>{new Intl.DateTimeFormat('en', {month: 'long', year: 'numeric', timeZone: 'UTC'}).format(new Date(note.data.date))}</time></div><div><div class="tags">{note.data.tags.map((tag) => <span>{tag}</span>)}</div><h2><a href={note.data.url} target="_blank" rel="noopener noreferrer">{note.data.title}<Icon name="diagonal" size={24}/></a></h2><p>{note.data.summary}</p><a class="text-link" href={note.data.url} target="_blank" rel="noopener noreferrer">Read the original on DEV<Icon name="diagonal" size={16}/></a></div></article>)}</div>
    <div class="small-callout"><Icon name="book" size={26}/><p>Good ideas deserve a little context. These links take you to the original articles, where the full stories live.</p></div>
  </div>
</Layout>
