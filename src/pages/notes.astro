---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Filters from '../components/Filters.astro';
import WritingCard from '../components/WritingCard.astro';
import { notes } from '../lib/content';
const all = await notes();
---
<Layout title="Writing" description="Personal essays, project write-ups and articles by Tanzil Ahmed. Read original posts here and follow links to writing published elsewhere.">
  <div class="container page-body"><header class="page-heading writing-index-heading"><div><p class="eyebrow">Personal essays, projects & things I’m learning</p><h1>My <span class="serif-word">writing.</span></h1><p>Some stories are published here; others link to the original article. A place for personal essays, project write-ups, and what I’m learning.</p></div><a class="text-link" href="/rss.xml">RSS feed<Icon name="diagonal" size={16}/></a></header>
    <Filters options={['On this site', 'Elsewhere']} label="Filter writing by publication"/>
    <div class="writing-list">{all.map((note) => <WritingCard note={note} filterable/>)}</div>
    {all.length === 0 && <p class="archive-footnote">New writing will appear here.</p>}
  </div>
</Layout>
